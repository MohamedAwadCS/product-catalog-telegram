# postgres password
POSTGRES_PASSWORD=your_db_password

# minio setup
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=products

# Database setup
DATABASE_URL=postgresql://postgres:password_of_your_choosing@127.0.0.1:5434/postgres

# Telegram bot setup
TELEGRAM_BOT_TOKEN=Your_Telegram_Bot_Token
ADMIN_ID=Your_Admin_Chat_ID

# Webhook secret for Telegram bot, this is used to verify that the request is coming from Telegram and not from a malicious source. You can generate a random string for this secret.
WEBHOOK_SECRET=Your_Webhook_Secret

WEBHOOK_URL=https://your-tunnel-address.trycloudflare.com
